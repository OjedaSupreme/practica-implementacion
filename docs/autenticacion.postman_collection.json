          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200', () => pm.response.to.have.status(200));",
              "pm.test('Token nuevo distinto', () => pm.expect(pm.response.json().accessToken).to.not.eql(pm.collectionVariables.get('tokenUsuario')));"
            ]
          }
        }
      ]
