{
  "info": {
    "name": "Sistema de tareas - Autenticación JWT",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Pruebas de seguridad de la autenticación (login, token ausente, inválido, expirado, rol, refresh y logout)."
  },
  "item": [
    {
      "name": "01 Login ADMIN",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin123*\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('tokenAdmin', pm.response.json().accessToken);",
              "pm.test('Cookie refresh_token presente', () => pm.expect(pm.cookies.has('refresh_token')).to.be.true);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Login contraseña incorrecta",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"incorrecta\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 401', () => pm.response.to.have.status(401));",
              "pm.test('codigo = CREDENCIALES_INVALIDAS', () => pm.expect(pm.response.json().codigo).to.eql('CREDENCIALES_INVALIDAS'));"
            ]
          }
        }
      ]
    },
