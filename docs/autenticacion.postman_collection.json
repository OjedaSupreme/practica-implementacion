    },
    {
      "name": "09 DELETE con rol USUARIO (403)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenUsuario}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/tareas/{{idTarea}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tareas",
            "{{idTarea}}"
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 403', () => pm.response.to.have.status(403));",
              "pm.test('codigo = ACCESO_DENEGADO', () => pm.expect(pm.response.json().codigo).to.eql('ACCESO_DENEGADO'));"
            ]
          }
        }
      ]
    },
    {
